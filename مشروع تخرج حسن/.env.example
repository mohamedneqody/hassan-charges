# Copy this file to .env and fill in your keys:  cp .env.example .env
# Get free keys at: https://aistudio.google.com/apikey

# MULTIPLE KEYS (recommended): comma-separated. When one key's free quota is
# exhausted (429), the app immediately rotates to the next key.
GEMINI_API_KEYS=your_key_1,your_key_2,your_key_3

# MODELS: quotas are per-model, so the pool alternates between both flash
# models — effectively doubling the free allowance. The first is preferred,
# the second is the fallback (also used when the first is under high demand).
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash

# Single-key alternative (if you only have one):
# GEMINI_API_KEY=your_key_here

# Ratio-commentary language: "ar" (Arabic, default) or "en".
# Metric names always stay in English, e.g. "Net Profit Margin: ارتفع من ...".
REPORT_LANGUAGE=ar

# ── بوت تليجرام (اختياري) — bot.py ──
# 1) @BotFather → /newbot → TOKEN هنا
TELEGRAM_BOT_TOKEN=
# 2) (موصى به) حصر من يتحدث للبوت — معرفك من @userinfobot
TELEGRAM_ALLOWED_IDS=
